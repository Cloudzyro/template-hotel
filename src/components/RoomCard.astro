---
import RoomScene from "./RoomScene.astro";
import type { Room } from "../data/site";

interface Props {
  room: Room;
  large?: boolean;
}
const { room, large = false } = Astro.props;
---

<article class:list={["room-card", { large }]}>
  <a href={`/rooms/${room.slug}/`} class="pic frame" tabindex="-1" aria-hidden="true">
    <RoomScene view={room.gallery[0].view} palette={room.palette} label="" uid={`card-${room.slug}`} />
  </a>
  <div class="body">
    <div class="top">
      <h3><a href={`/rooms/${room.slug}/`}>{room.name}</a></h3>
      <span class="key">Room {room.number}</span>
    </div>
    <p class="summary">{room.summary}</p>
    <p class="meta num">{room.beds} · Sleeps {room.sleeps} · {room.size} · From ${room.rateFrom} a night</p>
  </div>
</article>

<style>
  .room-card {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .pic {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .large .pic {
    aspect-ratio: 16 / 10;
  }
  .pic :global(svg) {
    width: 100%;
    height: 100%;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
  }
  .summary {
    color: var(--ink-2);
    margin-top: 6px;
    max-width: 34rem;
  }
  .meta {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
