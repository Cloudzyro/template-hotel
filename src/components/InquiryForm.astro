---
// Sends to PUBLIC_FORM_ENDPOINT (Formspree, Basin, a Supabase function or similar).
// With no endpoint set, sending opens the visitor's email app instead.
// Dates, guests and room arrive from the booking widget as query parameters.
import { site, rooms } from "../data/site";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const subject = `Inquiry for ${site.name}`;
---

<form
  class="inquiry"
  method="post"
  action={endpoint || `mailto:${site.email}`}
  data-endpoint={endpoint}
  data-email={site.email}
  data-subject={subject}
>
  {
    !endpoint && (
      <p class="note" role="note">
        This form isn't connected yet, so sending it opens your email app. You can also write to{" "}
        <a href={`mailto:${site.email}?subject=${encodeURIComponent(subject)}`}>{site.email}</a>.
      </p>
    )
  }
  <input type="hidden" name="_subject" value={subject} />
  <div class="row">
    <label class="field">
      <span>Your name</span>
      <input name="name" autocomplete="name" required />
    </label>
    <label class="field">
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>
  <label class="field">
    <span>About</span>
    <select name="topic">
      {site.contactTopics.map((t) => <option>{t}</option>)}
    </select>
  </label>
  <div class="row four">
    <label class="field">
      <span>Arrive</span>
      <input name="arrive" type="date" />
    </label>
    <label class="field">
      <span>Depart</span>
      <input name="depart" type="date" />
    </label>
    <label class="field">
      <span>Adults</span>
      <input name="adults" type="number" min="1" max="30" inputmode="numeric" />
    </label>
    <label class="field">
      <span>Children</span>
      <input name="children" type="number" min="0" max="20" inputmode="numeric" />
    </label>
  </div>
  <label class="field">
    <span>Room</span>
    <select name="room">
      <option value="">No preference</option>
      {rooms.map((r) => <option value={r.slug}>{r.name}</option>)}
    </select>
  </label>
  <label class="field">
    <span>Anything we should know</span>
    <textarea name="message" rows="5"></textarea>
  </label>
  <div class="actions">
    <button class="btn btn-primary" type="submit">Send inquiry</button>
    <p class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form.inquiry").forEach((form) => {
    const params = new URLSearchParams(window.location.search);
    let prefilled = false;
    for (const key of ["arrive", "depart", "adults", "children", "room"]) {
      const value = params.get(key);
      const el = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null;
      if (value && el) {
        el.value = value;
        prefilled = true;
      }
    }
    const topic = form.elements.namedItem("topic") as HTMLSelectElement;
    const asked = params.get("topic");
    if (asked && [...topic.options].some((o) => o.value === asked)) topic.value = asked;
    else if (prefilled) topic.value = "A stay";

    const status = form.querySelector<HTMLElement>(".status")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { endpoint, email, subject } = form.dataset;
      const data = new FormData(form);

      if (!endpoint) {
        const lines = [...data.entries()]
          .filter(([key, value]) => !key.startsWith("_") && String(value).trim())
          .map(([key, value]) => `${key}: ${value}`);
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject ?? "")}&body=${encodeURIComponent(lines.join("\n"))}`;
        status.textContent = "Your email app should open with your details filled in.";
        return;
      }

      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      button.disabled = true;
      status.textContent = "Sending";
      try {
        const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "Thank you. We'll reply within a day, usually sooner.";
      } catch {
        status.textContent = "";
        status.append("Sorry, that didn't send. Please email us at ");
        const link = Object.assign(document.createElement("a"), { href: `mailto:${email}`, textContent: email });
        status.append(link, ".");
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .inquiry {
    display: grid;
    gap: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 4vw, 32px);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .row.four {
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  }
  .note {
    font-size: 14px;
    color: var(--ink-2);
    background: var(--raised);
    border-radius: var(--radius);
    padding: 12px 16px;
  }
  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .status {
    font-size: 14px;
    color: var(--ink-2);
  }
</style>
